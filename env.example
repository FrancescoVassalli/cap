# Easy S3 <-> local-mock upload switch for the backend.
# Unset/blank  -> S3 presigner when the S3_BUCKET_NAME/AWS_* credentials above are present
# "mock"       -> localserver sink; browser PUTs to http://127.0.0.1:8787/uploads/... (bytes validated then discarded, no AWS)
# "signed"     -> local server sink with an HMAC-signed token (also used automatically when S3 config is missing)
# CAP_LOCAL_PRESIGNER_MODE="mock"